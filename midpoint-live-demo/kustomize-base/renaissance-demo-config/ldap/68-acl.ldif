olcAccess: to dn.exact="cn=admin,dc=example,dc=com"
  by anonymous auth
  by self write
  by * none
olcAccess: to attrs=userPassword,shadowLastChange
  by dn="cn=idm,ou=Administrators,dc=example,dc=com" write
  by dn="cn=admin,dc=example,dc=com" write
  by anonymous auth
  by self write
  by * none
olcAccess: to dn.base=""
  by * read
olcAccess: to dn.subtree="ou=people,dc=example,dc=com"
  by dn="cn=idm,ou=Administrators,dc=example,dc=com" write
olcAccess: to dn.subtree="ou=groups,dc=example,dc=com"
  by dn="cn=idm,ou=Administrators,dc=example,dc=com" write
olcAccess: to *
  by dn="cn=admin,dc=example,dc=com" write
  by dn="cn=idm,ou=Administrators,dc=example,dc=com" read
  by self read
  by * none
