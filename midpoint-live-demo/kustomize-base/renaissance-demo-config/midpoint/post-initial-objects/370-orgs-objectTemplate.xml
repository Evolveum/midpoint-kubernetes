<objectTemplate xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
                xmlns:icfs="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/resource-schema-3"
                xmlns:t="http://prism.evolveum.com/xml/ns/public/types-3"
                xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
                xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
                xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
                oid="3ffe38cb-f43f-4ae6-98ed-2bc9aaf171ce"
                version="3">
    <name>Default Project and Org Template</name>
    <mapping>
        <description>A hack to avoid feedback to HR feed - deleting accounts because they are not assigned</description>
        <strength>strong</strength>
        <expression>
            <value>
                <targetRef oid="bcf00adb-67c6-43be-bf60-3e6e1a52db25" type="c:RoleType"/>
            </value>
        </expression>
        <target>
            <c:path>assignment</c:path>
        </target>
        <condition>
                <script>
                <language>mel</language>
                <code>
                    focus.archetypeRef.exists(
                    ref,
                    ref.oid == '6a12b965-a1c2-47c9-87bd-19e84c71d814'
                    )
                    &amp;&amp; focus.oid != '9a60cdc6-f2ad-4414-964b-5fd1dfaec157'
                </code>
            </script>
        </condition>
    </mapping>
    <mapping>
        <description>A hack to avoid feedback to HR feed - deleting accounts because they are not assigned</description>
        <strength>strong</strength>
        <source>
            <c:path>subtype</c:path>
        </source>
        <expression>
            <value>
                <targetRef oid="3154fafb-9f9f-4c3b-93ae-7fffd43796bf" type="c:RoleType"/>
            </value>
        </expression>
        <target>
            <c:path>assignment</c:path>
        </target>
        <condition>
            <script>
                <language>mel</language>
                <code>focus.archetypeRef.exists(
                        ref,
                        ref.oid == '89a34123-1db7-4fc1-a053-6c42b82ef2ab'
                )</code>
            </script>
        </condition>
    </mapping>
    <mapping>
        <expression>
            <script>
                <language>mel</language>
                <code>
                    isPresent(focus.parentOrgRef)
                    ? cel.bind(
                    parentOrg,
                    midpoint.resolveReference(single(focus.parentOrgRef)),
                    'ou=' + focus.name + ',' + parentOrg.extension.ldapDn
                    )
                    : 'ou=' + focus.name + ',ou=Orgs,dc=example,dc=com'
                </code>
            </script>
        </expression>
        <target>
            <path>extension/ldapDn</path>
        </target>
    </mapping>
</objectTemplate>
